# HydroRainGuard — frontend environment
# Copy to `frontend/.env.local` and fill in.

# Leave EMPTY to call same-origin /api/*, which next.config.js
# proxies to the backend. This is the recommended setup: it keeps
# browser code away from localhost and sidesteps CORS entirely.
NEXT_PUBLIC_API_URL=

# Where the Next.js server should forward /api/* to.
API_PROXY_TARGET=http://localhost:8000

# CARTO basemaps API key (free, no CARTO account needed):
# https://carto.com/basemaps/apikey/
# Required since 25 Sep 2026 — without it CARTO raster tiles are
# replaced by an "API KEY REQUIRED" watermark.
# No NEXT_PUBLIC_ prefix: next.config.js forwards it to the map via its
# `env` block. It is still inlined at BUILD time (restart/redeploy after
# changing it) and still visible in the tile requests, so it is not a
# secret. Leave empty to fall back to OpenStreetMap tiles.
CARTO_BASEMAPS_KEY=
