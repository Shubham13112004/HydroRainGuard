# HydroRainGuard — backend environment
# Copy to `backend/.env` and fill in. Never commit the real file.

# Database. SQLite is fine locally; use Postgres/Neon in production
# (serverless filesystems are ephemeral, so SQLite loses data).
DATABASE_URL=sqlite+aiosqlite:///./hydro_rain_guard.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# OpenWeatherMap key, or leave as "demo" to use the regional
# rainfall dataset (no key required).
OPENWEATHER_API_KEY=demo

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,https://hydro-rain-guard.vercel.app

# "development" leaves the maintenance endpoints open so local
# dev just works. Set to "production" on a real deployment.
ENVIRONMENT=development

# Required when ENVIRONMENT=production. Protects
# POST /api/init-db and un-redacts GET /api/assessments.
ADMIN_TOKEN=
